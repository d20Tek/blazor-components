<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>D20Tek Blazor Components (all)</Title>
    <Description>A convenience meta-package that bundles all of the D20Tek Blazor component packages (Functionally, Markdown, Modal, Pager, Spinner, Timer, Toast, TogglePanel, ToggleSwitch, Vertically). Install this to get the full component suite in one reference. If you only need a few components, install the individual packages instead.</Description>
    <PackageTags>Blazor .NET Components WebAssembly Bundle All Meta</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Meta-package has no build output, so no symbols (.pdb) exist; skip the empty .snupkg
         that nuget.org rejects with "The package does not contain any symbol (.pdb) files." -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\D20Tek.BlazorComponents.Markdown\D20Tek.BlazorComponents.Markdown.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.Modal\D20Tek.BlazorComponents.Modal.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.Functionally\D20Tek.BlazorComponents.Functionally.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.Pager\D20Tek.BlazorComponents.Pager.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.Spinner\D20Tek.BlazorComponents.Spinner.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.Timer\D20Tek.BlazorComponents.Timer.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.Toast\D20Tek.BlazorComponents.Toast.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.TogglePanel\D20Tek.BlazorComponents.TogglePanel.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.ToggleSwitch\D20Tek.BlazorComponents.ToggleSwitch.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.Vertically\D20Tek.BlazorComponents.Vertically.csproj" />
  </ItemGroup>

</Project>
