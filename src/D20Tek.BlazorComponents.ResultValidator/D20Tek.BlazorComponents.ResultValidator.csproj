    <PackageTags>Blazor .NET Components WebAssembly Validation Result Validator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="D20Tek.Functional" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D20Tek.BlazorComponent.Core\D20Tek.BlazorComponent.Core.csproj" />
    <ProjectReference Include="..\D20Tek.BlazorComponents.Toast\D20Tek.BlazorComponents.Toast.csproj" />
  </ItemGroup>

</Project>
