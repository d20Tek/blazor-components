<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>A Blazor component for providing a self-positioning FlyoutMenu (popover) triggered from a kebab button or a custom trigger element, with collision-aware placement, data-driven or templated items, and full keyboard accessibility.</Description>
    <PackageTags>Blazor .NET Components; WebAssembly; menu; flyout; popover; kebab</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D20Tek.BlazorComponent.Core\D20Tek.BlazorComponent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\Menu.css" />
  </ItemGroup>

</Project>
